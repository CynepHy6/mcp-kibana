# Kibana APM MCP Server Configuration

# Required: Kibana host (not the Elasticsearch :9200 cluster)
KIBANA_BASE_URL=https://kibana.example.com

# Authentication: API key (sent as "Authorization: ApiKey <key>") ...
KIBANA_API_KEY=your_api_key_here

# ... or login and password (Basic auth). Used only when KIBANA_API_KEY is empty.
# KIBANA_USERNAME=your_login
# KIBANA_PASSWORD=your_password

# Optional: request timeout in milliseconds (default: 30000)
# KIBANA_TIMEOUT_MS=30000
