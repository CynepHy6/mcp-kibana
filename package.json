{
    "name": "mcp-kibana",
    "version": "1.0.0",
    "description": "MCP server for Kibana APM: services, transaction groups, error groups, trace samples and trace waterfall",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CynepHy6/mcp-kibana.git"
    },
    "bugs": {
        "url": "https://github.com/CynepHy6/mcp-kibana/issues"
    },
    "homepage": "https://github.com/CynepHy6/mcp-kibana#readme",
    "main": "build/index.js",
    "type": "module",
    "bin": {
        "mcp-kibana": "./build/index.js"
    },
    "scripts": {
        "compile": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
        "prepublishOnly": "npm run compile",
        "start": "node ./build/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "files": [
        "build",
        "LICENSE"
    ],
    "keywords": [
        "mcp",
        "kibana",
        "apm",
        "elastic",
        "cursor",
        "npx"
    ],
    "author": "",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^22.10.0",
        "jest": "^29.5.0",
        "nock": "^13.3.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.15.0",
        "axios": "^1.11.0",
        "dotenv": "^16.4.7",
        "zod": "^4.6.7"
    }
}
